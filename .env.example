DB_PATH=./data/pm-tracker.db
LOG_LEVEL=info

# ============ Tracking ============
# Window length of the tracked series, in minutes (the 5m up/down markets).
WINDOW_MINUTES=5
# Snapshot cadence in seconds; must divide 60.
# 5s over a 300s window is ~60 snapshots per market.
SNAPSHOT_INTERVAL_SECONDS=5
# How many upcoming windows discovery looks ahead (12 x 5m = 1 hour).
DISCOVERY_WINDOWS_AHEAD=12

# ============ Trading bot ============
# Everything below is inert unless TRADING_MODE is set to paper or live.

# off | paper | live   (default: off)
# live places REAL orders and spends REAL funds.
TRADING_MODE=off

# Any non-empty value (other than 0) refuses all trading, whatever the mode.
# KILL_SWITCH=1

# --- Risk controls ---
STAKE_USD=100
MAX_TRADES_PER_DAY=10
DAILY_LOSS_LIMIT_USD=300

# --- Strategy thresholds (favorite-55) ---
# Entry band on the favorite's best ask: [ENTRY_MIN_ASK, ENTRY_MAX_ASK)
ENTRY_MIN_ASK=0.90
ENTRY_MAX_ASK=0.97
# Max tolerated book spread; the edge dies above ~3c.
MAX_BOOK_SPREAD=0.03
# Enter this many seconds before the window closes.
TRADING_ENTRY_LEAD_SECONDS=30

# --- Live execution ---
# Taker fees above this many bps erase the edge; live mode refuses to trade.
MAX_FEE_RATE_BPS=100
# Cancel (do not chase) if the limit order is unfilled after this long.
ORDER_FILL_TIMEOUT_MS=60000
ORDER_POLL_INTERVAL_MS=3000

# --- Wallet auth (live mode only) ---
# POLY_PRIVATE_KEY=0x...
# Polymarket proxy wallet address, if you fund through one.
# POLY_FUNDER_ADDRESS=0x...
